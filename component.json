      "body": "if (!$ctrl.emailOrUsername || !$ctrl.password || $ctrl.submitting) {\n  return;\n}\n$ctrl.onSubmit({ credentials: { emailOrUsername: $ctrl.emailOrUsername, password: $ctrl.password }, rememberMe: $ctrl.rememberMe });",
